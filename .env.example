# Domain hoặc IP public của PocketBase (để trình duyệt và bot Zalo tải ảnh)
# Ví dụ nếu dùng domain: PUBLIC_PB_URL=https://pb.yourdomain.com hoặc https://yourdomain.com:8090
# Ví dụ nếu dùng IP VPS:  PUBLIC_PB_URL=http://123.45.67.89:8090
PUBLIC_PB_URL=http://localhost:8090

# Cổng Web app (mặc định 3000)
PORT=3000

# ==========================================
# CẤU HÌNH GMAIL GỬI THƯ TOÀN HỆ THỐNG (SMTP)
# ==========================================
# 1. Bật xác thực 2 bước trên Gmail
# 2. Vào https://myaccount.google.com/apppasswords tạo mật khẩu ứng dụng 16 ký tự
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourwedding@gmail.com
