# Cấu hình Nginx mẫu cho dự án Thiệp Cưới (wedding_multiple)
# Đường dẫn file trên VPS: /etc/nginx/sites-available/wedding.conf

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # Nơi chứa mã nguồn trên VPS
    root /var/www/wedding_multiple;
    index index.html;

    # 1. Reverse Proxy sang Node.js server (Chạy PM2: pm2 start server.js)
    # Khuyên dùng cách này để hỗ trợ preview Zalo / Facebook động
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # 2. File tĩnh lớn (nhạc, ảnh) cho Nginx cache trực tiếp để giảm tải cho Node.js
    location /images/ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    location ~* \.(mp3|jpg|jpeg|png|gif|ico|css|js)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }
}
